# Copy to .env.production on the deployment host. Never commit real values.
BACKEND_IMAGE=ghcr.io/your-org/supply-chain-autopilot-api:latest
FRONTEND_IMAGE=ghcr.io/your-org/supply-chain-autopilot-web:latest
POSTGRES_DB=supply_chain
POSTGRES_USER=supply_chain
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://supply_chain:replace-with-url-encoded-password@postgres:5432/supply_chain
REDIS_URL=redis://redis:6379/0

# Public origin allowed to call the API.
CORS_ORIGINS=https://supply-chain.example.com
FRONTEND_PORT=3000
API_PORT=8000
LOG_LEVEL=INFO
DEMO_MODE=false

# Server-only frontend-to-API authentication and tenant identity.
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
DEFAULT_ORGANIZATION_ID=replace-with-organization-uuid
DEFAULT_USER_ID=replace-with-user-uuid
