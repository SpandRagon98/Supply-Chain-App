# Runtime environment
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Local service dependencies. Change these before using shared environments.
POSTGRES_DB=supply_chain
POSTGRES_USER=supply_chain
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://supply_chain:change-me-for-local-development@localhost:5432/supply_chain
REDIS_URL=redis://localhost:6379/0

# AI is optional. The application will use its deterministic mock provider when
# no OpenAI key is present.
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Application integration settings
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
